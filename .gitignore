# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
!.env.example

# signing keys and release artifacts (the repository is public)
*.keystore
*.aab
*.apk
*.ipa
*.xcarchive
*service-account*.json
google-services.json
GoogleService-Info.plist
AuthKey_*.p8

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# 自分の部品（modules/）を Android で作ったときに、Gradle が作るもの（npx expo prebuild のあとの ./gradlew）
modules/*/android/build/
modules/*/android/.cxx/
modules/*/android/.gradle/
