{
  "expo": {
    "name": "LINCREA",
    "slug": "lincrea",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.iam74k4.LincreaApp",
      "appleTeamId": "NL9ZXK2SGR",
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      },
      "infoPlist": {
        "NSHealthShareUsageDescription": "Walk the Talk に登録する歩数を、ヘルスケアから読み取ります。",
        "NSHealthUpdateUsageDescription": "LINCREA はヘルスケアにデータを書き込みません（Walk the Talk に登録する歩数を、読み取るだけです）。",
        "NSCameraUsageDescription": "ページでファイルを添付するときに、写真を撮るために使います。",
        "NSMicrophoneUsageDescription": "ページでファイルを添付するときに、動画を撮るために使います。"
      },
      "privacyManifests": {
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeFitness",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ]
      },
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      }
    },
    "android": {
      "package": "com.iam74k4.LincreaApp",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Face ID でログインするために使います。"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Face ID でログインするために使います。"
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false,
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#007AFF"
        }
      ],
      "./plugins/withAndroidReleaseSigning"
    ],
    "scheme": "lincrea",
    "extra": {
      "eas": {
        "projectId": "0b7b8a00-dbbd-41ce-b7ac-11bbedbb0c26"
      }
    },
    "owner": "iam74k4"
  }
}
