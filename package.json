    "ios": "expo run:ios",
    "lint": "expo lint",
    "check:pages": "tsx scripts/check-page-scripts.ts",
    "test": "jest",
    "postinstall": "patch-package"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/ios/",
      "/android/"
